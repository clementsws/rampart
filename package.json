{
  "name": "rampart",
  "version": "1.0.0",
  "private": true,
  "description": "Rampart - castle building & artillery game for mobile browsers, running on Cloudflare Workers + Durable Objects",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "check": "npm run typecheck && npm test && npm run build",
    "sim": "esbuild scripts/sim.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/sim.mjs && node node_modules/.cache/sim.mjs",
    "campaign-sim": "esbuild scripts/campaign-sim.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/campaign-sim.mjs && node node_modules/.cache/campaign-sim.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
